<div class="titrePage">
  <h2>Face Tag Editor</h2>
</div>

<style>
.help-container {
  display: flex;
  gap: 20px;
  margin-top: 20px;
}

.help-column {
  flex: 1;
  background: #f9f9f9;
  padding: 15px;
  border-radius: 5px;
  border: 1px solid #ddd;
}

.help-column h3 {
  margin-top: 0;
  color: #333;
  border-bottom: 2px solid #ff7700;
  padding-bottom: 10px;
}

.help-section {
  margin-bottom: 25px;
}

.help-section h4 {
  color: #555;
  margin-top: 15px;
  margin-bottom: 8px;
}

.help-section p {
  text-align : left ;
  line-height: 1.4;
  color: #666;
}

.help-section ul {
  margin: 10px 0;
  padding-left: 25px;
}

.help-section li {
  margin-bottom: 8px;
  line-height: 1.5;
}

.help-note {
  background: #fff3cd;
  border-left: 4px solid #ffc107;
  padding: 10px 15px;
  margin: 15px 0;
  border-radius: 3px;
}

.help-tip {
  background: #d1ecf1;
  border-left: 4px solid #17a2b8;
  padding: 10px 15px;
  margin: 15px 0;
  border-radius: 3px;
}

@media (max-width: 768px) {
  .help-container {
    flex-direction: column;
  }
}
</style>

<div class="help-container">

 <!-- Colonne gauche -->
  <div class="help-column">
    <h3>{'Aide  & Paramètres'|@translate}</h3>
    <h3>{'Help  & Settings'|@translate}</h3>
    
    <div class="help-section">
      <h4>{'à venir bientôt !!!'|@translate}</h4>  
      <h4>{'coming soon !!!'|@translate}</h4>
      
    </div>

   
   

        
  </div>

  <!-- Colonne droite -->
  <div class="help-column">
